{
  "name": "dreamwork",
  "productName": "DreamWorks",
  "description": "Experience-first screen recorder: circular webcam PiP, whiteboard, and live meeting. Electron + React.",
  "author": "Annabelle Lee <annabellelee8@gmail.com>",
  "private": true,
  "repository": "github.com/Funghi88/DreamWorks",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electronmon .\"",
    "electron:dev": "npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electronmon .",
    "dev:web": "vite --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "pack": "npm run create-icns && rm -rf dist && npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "signaling": "npx tsx server/signaling-server.ts",
    "create-app-icon": "node scripts/create-app-icon.js",
    "create-icns": "node scripts/create-icns.js",
    "copy-settings-to-defaults": "node scripts/copy-settings-to-defaults.cjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "^0.10.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "postcss": "^8.5.8",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.funghi88.dreamworks",
    "productName": "DreamWorks",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "DreamWorks needs camera access for recording and live preview.",
        "NSMicrophoneUsageDescription": "DreamWorks needs microphone access for recording audio.",
        "NSScreenCaptureUsageDescription": "DreamWorks needs screen capture to share or record your display."
      }
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "defaults",
        "to": "defaults",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
